<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:paddingTop="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/saveBackText"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:text="@string/ui_050"
            android:textColor="@color/fit_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ui_051"
            android:textColor="@color/fit_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/clothingPreviewImage"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/ui_007"
            android:padding="16dp"
            android:scaleType="fitCenter" />

        <EditText
            android:id="@+id/clothingNameEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_input"
            android:hint="@string/ui_052"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:paddingHorizontal="16dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/categoryEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="@string/ui_053"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:paddingHorizontal="16dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/colorEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="@string/ui_054"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:paddingHorizontal="16dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/memoEditText"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:hint="@string/ui_055"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ui_056"
            android:textColor="@color/fit_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/saveClothingButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_primary_button"
            android:text="@string/ui_057"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
