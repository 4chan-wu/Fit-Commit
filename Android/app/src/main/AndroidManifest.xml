        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".activities.AnalysisResultActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ClothingSaveActivity"
