<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:text="✦\n👤"
            android:textSize="30sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="패트리(AI 코디)"
            android:textColor="@color/fit_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="AI 패션 어시스턴트, 패트리에게 물어보세요!"
            android:textColor="@color/fit_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/startChatButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_card"
            android:text="새로운 코디 시작하기\n패트리에게 오늘의 상황과 스타일을 물어보세요."
            android:textAllCaps="false"
            android:textColor="@color/fit_text" />

        <Button
            android:id="@+id/chatHistoryButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:text="채팅 히스토리 보기\n이전에 나눈 스타일 상담을 다시 확인해요."
            android:textAllCaps="false"
            android:textColor="@color/fit_text" />
    </LinearLayout>
</ScrollView>
