<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="190dp"
    android:layout_height="150dp"
    android:layout_marginEnd="14dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical">

    <TextView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_soft_button"
        android:gravity="center"
        android:text="✦"
        android:textColor="@color/fit_primary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/outfitTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="오피스 캐주얼"
        android:textColor="@color/fit_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/outfitSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="네이비 리넨 셔츠\n그레이 슬랙스"
        android:textColor="@color/fit_text_secondary"
        android:textSize="13sp" />
</LinearLayout>
