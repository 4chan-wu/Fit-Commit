# Fit Commit Backend - local uvicorn + Supabase PostgreSQL

# Supabase PostgreSQL connection string.
# Replace this dummy value later with your real Supabase connection string.
# Example:
# DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@YOUR_SUPABASE_HOST:6543/postgres?sslmode=require

# API keys - replace with real values for full feature testing.
OPENAI_API_KEY=your_openai_api_key_here

TOSS_CLIENT_KEY=your_toss_client_key_here
TOSS_SECRET_KEY=your_toss_secret_key_here
TOSS_SUCCESS_URL=http://localhost:5173/payments/success
TOSS_FAIL_URL=http://localhost:5173/payments/fail
