<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="내 옷장"
                    android:textColor="@color/fit_text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/closetCountText"
                    style="@style/FitCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="옷을 불러오는 중이에요" />
            </LinearLayout>

            <ImageView
                android:id="@+id/searchClosetButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_toolbar_action"
                android:contentDescription="옷 검색"
                android:padding="12dp"
                android:src="@drawable/ic_search" />

            <ImageView
                android:id="@+id/filterClosetButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_toolbar_action"
                android:contentDescription="계절 필터"
                android:padding="12dp"
                android:src="@drawable/ic_filter" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/backendStatusContainer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/backendSyncStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="데이터를 불러오지 못했어요"
                android:textColor="@color/fit_danger"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/backendRefreshButton"
                android:layout_width="64dp"
                android:layout_height="36dp"
                android:contentDescription="데이터 다시 불러오기"
                android:gravity="center"
                android:text="다시 시도"
                android:textColor="@color/fit_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/experimentalToolsRow"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:visibility="gone">

            <View
                android:id="@+id/bodyMeasureButton"
                android:layout_width="1dp"
                android:layout_height="1dp" />

            <View
                android:id="@+id/spaceScanButton"
                android:layout_width="1dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="옷장"
                    android:textColor="@color/fit_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="옷을 보관할 공간을 선택하세요"
                    android:textColor="@color/fit_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/wardrobeManageButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingHorizontal="10dp"
                android:text="관리"
                android:textColor="@color/fit_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/createWardrobeButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_soft_button"
                android:gravity="center"
                android:minWidth="96dp"
                android:paddingHorizontal="14dp"
                android:text="＋ 새 옷장"
                android:textColor="@color/fit_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingEnd="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/wardrobeFilterRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="카테고리"
            android:textColor="@color/fit_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingEnd="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categoryFilterRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/FitSectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="내 아이템" />

            <TextView
                android:id="@+id/closetSortButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="4dp"
                android:text="최신순 ︾"
                android:textColor="@color/fit_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/closetGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="96dp"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/closetEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_closet_empty_icon"
                    android:contentDescription=""
                    android:padding="20dp"
                    android:src="@drawable/ic_closet_empty" />

                <TextView
                    android:id="@+id/closetEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:includeFontPadding="false"
                    android:text="첫 번째 옷을 등록해보세요"
                    android:textColor="@color/fit_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/closetEmptyDescription"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="사진 한 장이면 내 옷장을\n간편하게 정리할 수 있어요."
                    android:textColor="@color/fit_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/firstClothingButton"
                    android:layout_width="240dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_add_clothing_button"
                    android:drawableStart="@drawable/ic_add_garment_white"
                    android:drawablePadding="9dp"
                    android:gravity="center"
                    android:text="첫 번째 옷 등록하기"
                    android:textColor="@color/fit_on_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/closetNoResultsText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:padding="32dp"
                android:text="조건에 맞는 옷이 없어요.\n검색어나 필터를 바꿔보세요."
                android:textColor="@color/fit_text_secondary"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/addClothingButton"
        android:layout_width="140dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_add_clothing_button"
        android:contentDescription="새 옷 등록"
        android:drawableStart="@drawable/ic_add_garment_white"
        android:drawablePadding="8dp"
        android:elevation="3dp"
        android:gravity="center"
        android:paddingStart="17dp"
        android:paddingEnd="19dp"
        android:text="새 옷 등록"
        android:textColor="@color/fit_on_dark"
        android:textSize="15sp"
        android:textStyle="bold" />
</FrameLayout>
