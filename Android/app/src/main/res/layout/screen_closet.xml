<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="내 옷장"
                    android:textColor="@color/fit_text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/closetCountText"
                    style="@style/FitCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="옷을 불러오는 중이에요" />
            </LinearLayout>

            <ImageView
                android:id="@+id/searchClosetButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip"
                android:contentDescription="옷 검색"
                android:padding="12dp"
                android:src="@drawable/ic_search" />

            <ImageView
                android:id="@+id/filterClosetButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip"
                android:contentDescription="계절 필터"
                android:padding="12dp"
                android:src="@drawable/ic_filter" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/backendStatusContainer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/backendSyncStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="데이터를 불러오지 못했어요"
                android:textColor="@color/fit_danger"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/backendRefreshButton"
                android:layout_width="64dp"
                android:layout_height="36dp"
                android:contentDescription="데이터 다시 불러오기"
                android:gravity="center"
                android:text="다시 시도"
                android:textColor="@color/fit_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/experimentalToolsRow"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:visibility="gone">

            <View
                android:id="@+id/bodyMeasureButton"
                android:layout_width="1dp"
                android:layout_height="1dp" />

            <View
                android:id="@+id/spaceScanButton"
                android:layout_width="1dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="옷장"
                    android:textColor="@color/fit_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="옷을 보관할 공간을 선택하세요"
                    android:textColor="@color/fit_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/createWardrobeButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_soft_button"
                android:gravity="center"
                android:minWidth="96dp"
                android:paddingHorizontal="14dp"
                android:text="＋ 새 옷장"
                android:textColor="@color/fit_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingEnd="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/wardrobeFilterRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="카테고리"
            android:textColor="@color/fit_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingEnd="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categoryFilterRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/FitSectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="내 아이템" />

            <TextView
                android:id="@+id/closetSortButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="4dp"
                android:text="최신순 ︾"
                android:textColor="@color/fit_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/closetGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="96dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/closetEmptyText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:lineSpacingExtra="7dp"
                android:padding="32dp"
                android:text="아직 등록한 옷이 없어요.\n아래 ‘옷 추가’ 버튼으로 시작해보세요."
                android:textColor="@color/fit_text_secondary"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/addClothingButton"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_fab"
        android:contentDescription="새 옷 추가"
        android:elevation="10dp"
        android:gravity="center"
        android:minWidth="124dp"
        android:paddingHorizontal="20dp"
        android:text="＋ 옷 추가"
        android:textColor="@color/fit_on_dark"
        android:textSize="15sp"
        android:textStyle="bold" />
</FrameLayout>
