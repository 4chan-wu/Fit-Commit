<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="46dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/ui_058"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/ui_059"
            android:textColor="@color/fit_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/loginSubtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/ui_060"
            android:textColor="@color/fit_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/socialLoginTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="@string/ui_061"
            android:textColor="@color/fit_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/kakaoButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_social_kakao"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="17dp"
            android:visibility="gone">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_social_kakao" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/ui_062" android:textColor="#191919" android:textSize="15sp" android:textStyle="bold" />
            <Space android:layout_width="24dp" android:layout_height="24dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/naverButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_social_naver"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="17dp"
            android:visibility="gone">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_social_naver" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/ui_063" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
            <Space android:layout_width="24dp" android:layout_height="24dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/googleButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_social_google"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="17dp"
            android:visibility="gone">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_social_google" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/ui_064" android:textColor="@color/fit_text" android:textSize="15sp" android:textStyle="bold" />
            <Space android:layout_width="24dp" android:layout_height="24dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/appleButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_social_apple"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="17dp"
            android:visibility="gone">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_social_apple" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/ui_065" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
            <Space android:layout_width="24dp" android:layout_height="24dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/socialLoginDivider"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/fit_border" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="14dp" android:text="@string/ui_066" android:textColor="@color/fit_text_secondary" android:textSize="12sp" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/fit_border" />
        </LinearLayout>

        <EditText
            android:id="@+id/nameEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:autofillHints="name"
            android:hint="@string/ui_067"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:visibility="gone" />

        <EditText
            android:id="@+id/emailEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/bg_input"
            android:hint="@string/ui_068"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/phoneEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:autofillHints="phone"
            android:hint="@string/ui_069"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:visibility="gone" />

        <EditText
            android:id="@+id/passwordEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:autofillHints="password"
            android:background="@drawable/bg_input"
            android:hint="@string/ui_070"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/passwordConfirmEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:autofillHints="password"
            android:hint="@string/ui_071"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/feedbackText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/fit_danger"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/submitButton"
            style="@style/FitButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/ui_072"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modeSwitchText"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="@string/ui_073"
            android:textColor="@color/fit_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/privacyPolicyLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/ui_074"
            android:textColor="@color/fit_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
