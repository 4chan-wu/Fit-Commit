# Fitcommit Backend

# Supabase PostgreSQL transaction pooler. URL-encode special characters in the
# database password. Copy the exact URI from Supabase > Connect > Transaction.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DB_PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase REST API for public.clothes.
# Keep SUPABASE_SERVICE_ROLE_KEY only on Backend. Never ship it in iOS/Android.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_CLOTHING_BUCKET=clothing-images

# App registration test mode.
# false means apps should save clothes without calling the AI /predict API.
ENABLE_AI_ANALYSIS=false

# FastAPI CORS. Use * during development only.
# For production, replace with exact web origins such as https://example.com.
CORS_ALLOW_ORIGINS=*

# Local-only compatibility switch. Keep false on AWS/production.
ALLOW_TEST_USER_ID=false

# OpenAI chat
OPENAI_API_KEY=your_openai_api_key_here

# Toss Payments
TOSS_CLIENT_KEY=your_toss_client_key_here
TOSS_SECRET_KEY=your_toss_secret_key_here
TOSS_SUCCESS_URL=http://localhost:5173/payments/success
TOSS_FAIL_URL=http://localhost:5173/payments/fail
