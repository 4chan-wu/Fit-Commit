<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101217">

    <FrameLayout
        android:id="@+id/bodyCaptureContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/bodyCameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.fitcommit.app.views.PoseOverlayView
            android:id="@+id/poseOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#A6000000"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="32dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/bodyCameraBackText"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:text="← 뒤로"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="신체 비율 측정"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="전신 관절을 분석해 나에게 맞는 실루엣을 찾아드려요."
                android:textColor="#D7DCEC"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/bodyCameraStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="실시간 예상 키"
                android:textColor="@color/fit_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/liveHeightText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="--.- cm"
                android:textColor="@color/fit_text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/liveGuideText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="머리부터 발끝까지 전신이 화면에 들어오도록 2~3m 떨어져 서 주세요."
                android:textColor="@color/fit_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/measureBodyButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_primary_button"
                android:enabled="false"
                android:text="전신 인식 대기 중"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/measurementResultContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fit_bg"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="42dp"
            android:paddingEnd="20dp"
            android:paddingBottom="34dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_selected"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="BODY PROFILE"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="신체 비율 분석이\n완료됐어요"
                android:textColor="@color/fit_text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultBodyShapeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/fit_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="예상 측정값"
                    android:textColor="@color/fit_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView android:id="@+id/resultHeightText" style="@style/BodyMetricValue" />
                <TextView android:id="@+id/resultShoulderText" style="@style/BodyMetricValue" />
                <TextView android:id="@+id/resultHipText" style="@style/BodyMetricValue" />
                <TextView android:id="@+id/resultArmText" style="@style/BodyMetricValue" />
                <TextView android:id="@+id/resultLegText" style="@style/BodyMetricValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✦ 스타일 제안"
                    android:textColor="@color/fit_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resultRecommendationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:textColor="@color/fit_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@color/fit_primary_soft"
                android:padding="14dp"
                android:text="카메라 기반 AI 추정값으로 자세·거리·의상에 따라 오차가 발생할 수 있으며 의료 또는 맞춤 제작용 실측값이 아닙니다."
                android:textColor="@color/fit_primary_dark"
                android:textSize="12sp" />

            <Button
                android:id="@+id/saveMeasurementButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_primary_button"
                android:text="저장 및 완료"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/retakeMeasurementButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_soft_button"
                android:text="다시 측정"
                android:textAllCaps="false"
                android:textColor="@color/fit_primary"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
