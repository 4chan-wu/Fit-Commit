<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_079"
        android:textColor="@color/fit_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/ui_080"
        android:textColor="@color/fit_text_secondary"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp" />

    <Button
        android:id="@+id/takeClothingPhotoButton"
        style="@style/FitButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="@string/ui_081"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/pickClothingPhotoButton"
        style="@style/FitButton.Secondary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:text="@string/ui_082"
        android:textAllCaps="false"
        android:textColor="@color/fit_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cancelClothingSourceButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/ui_083"
        android:textColor="@color/fit_text_secondary"
        android:textSize="14sp" />

</LinearLayout>
