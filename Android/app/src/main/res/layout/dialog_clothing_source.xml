<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="의류 이미지 추가"
        android:textColor="@color/fit_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="옷 한 벌만 화면 중앙에 놓아주세요.\n단순한 배경과 밝은 조명에서 더 정확해요."
        android:textColor="@color/fit_text_secondary"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp" />

    <Button
        android:id="@+id/takeClothingPhotoButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_primary_button"
        android:text="카메라로 촬영"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/pickClothingPhotoButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_soft_button"
        android:text="갤러리에서 선택"
        android:textAllCaps="false"
        android:textColor="@color/fit_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cancelClothingSourceButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="취소"
        android:textColor="@color/fit_text_secondary"
        android:textSize="14sp" />

</LinearLayout>
