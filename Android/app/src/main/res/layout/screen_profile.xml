<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_078"
            android:textColor="@color/fit_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ui_118"
            android:textColor="@color/fit_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/ui_119"
            android:textColor="@color/fit_text_secondary"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_037"
                android:textColor="@color/fit_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bodyMeasurementSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/fit_text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/startBodyMeasurementButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_primary_button"
                android:text="@string/ui_120"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/ui_121"
            android:textColor="@color/fit_text_secondary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/languageSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:textAllCaps="false"
            android:textColor="@color/fit_text" />

        <Button
            android:id="@+id/privacyPolicyButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_card"
            android:text="@string/ui_122"
            android:textAllCaps="false"
            android:textColor="@color/fit_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:text="@string/ui_123"
            android:textColor="@color/fit_text" />

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_card"
            android:text="@string/ui_124"
            android:textAllCaps="false"
            android:textColor="@color/fit_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/deleteAccountButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:text="@string/ui_125"
            android:textAllCaps="false"
            android:textColor="@color/fit_danger"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
