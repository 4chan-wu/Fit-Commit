<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101217">

    <FrameLayout
        android:id="@+id/bodyCaptureContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/bodyCameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <android.opengl.GLSurfaceView
            android:id="@+id/bodyArCameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.fitcommit.app.views.PoseOverlayView
            android:id="@+id/poseOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#A6000000"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="32dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/bodyCameraBackText"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:text="@string/ui_028"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ui_029"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/ui_030"
                android:textColor="#D7DCEC"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/bodyCameraStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/measurementModeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_031"
                android:textColor="@color/fit_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/liveHeightText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/ui_032"
                android:textColor="@color/fit_text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/liveGuideText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/ui_033"
                android:textColor="@color/fit_text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/manualHeightInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:hint="@string/ui_034"
                android:inputType="numberDecimal"
                android:maxLength="5"
                android:paddingHorizontal="16dp"
                android:textColor="@color/fit_text"
                android:textColorHint="@color/fit_text_secondary"
                android:textSize="15sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/useManualHeightButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_soft_button"
                android:text="@string/ui_035"
                android:textAllCaps="false"
                android:textColor="@color/fit_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/measureBodyButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_primary_button"
                android:enabled="false"
                android:text="@string/ui_036"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/measurementResultContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fit_bg"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="42dp"
            android:paddingEnd="20dp"
            android:paddingBottom="34dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_selected"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="@string/ui_037"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/ui_038"
                android:textColor="@color/fit_text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultBodyShapeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/fit_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_039"
                    android:textColor="@color/fit_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView android:id="@+id/resultHeightText" style="@style/BodyMetricValue" />
                <TextView android:id="@+id/resultShoulderText" style="@style/BodyMetricValue" />
                <TextView android:id="@+id/resultHipText" style="@style/BodyMetricValue" />
                <TextView android:id="@+id/resultArmText" style="@style/BodyMetricValue" />
                <TextView android:id="@+id/resultLegText" style="@style/BodyMetricValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_040"
                    android:textColor="@color/fit_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resultRecommendationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:textColor="@color/fit_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@color/fit_primary_soft"
                android:padding="14dp"
                android:text="@string/ui_041"
                android:textColor="@color/fit_primary_dark"
                android:textSize="12sp" />

            <Button
                android:id="@+id/saveMeasurementButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_primary_button"
                android:text="@string/ui_042"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/retakeMeasurementButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_soft_button"
                android:text="@string/ui_043"
                android:textAllCaps="false"
                android:textColor="@color/fit_primary"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
