# Fitcommit Backend

# Local Docker PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@db:5432/fitcommit

# Local Python server -> local Docker PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fitcommit

# Supabase PostgreSQL example:
# DATABASE_URL=postgresql://postgres.xxxxx:YOUR_URL_ENCODED_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase REST API for public.clothes.
# Keep SUPABASE_SERVICE_ROLE_KEY only on Backend. Never ship it in iOS/Android.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_CLOTHING_BUCKET=clothing-images

# JWT
SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI chat
OPENAI_API_KEY=your_openai_api_key_here

# Toss Payments
TOSS_CLIENT_KEY=your_toss_client_key_here
TOSS_SECRET_KEY=your_toss_secret_key_here
TOSS_SUCCESS_URL=http://localhost:5173/payments/success
TOSS_FAIL_URL=http://localhost:5173/payments/fail
