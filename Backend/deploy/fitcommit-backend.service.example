[Unit]
Description=Fitcommit Backend FastAPI service
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Backend
EnvironmentFile=/home/ubuntu/fitcommit_backend.env
ExecStart=/home/ubuntu/Backend/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
